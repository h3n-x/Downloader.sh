# Copy to .env and adjust. All variables are optional; defaults are production-safe.
# Never commit .env.

# production | development | test (development enables /api/docs)
DL_ENVIRONMENT=production

# Secret for anonymised rate-limit keys (HMAC of client IP). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random value is generated per process (fine for one instance).
DL_CLIENT_KEY_SECRET=

# Comma-separated provider slugs to enable (default: all supported).
# youtube,x,instagram,tiktok,facebook,reddit,twitch,vimeo,soundcloud,bluesky,dailymotion,streamable
DL_PROVIDERS=

# Limits
DL_MAX_FILESIZE=2147483648
DL_MAX_DURATION=10800
DL_DISK_QUOTA=21474836480
DL_DOWNLOAD_TTL=900
DL_MAX_CONCURRENT_DOWNLOADS=4
DL_MAX_QUEUED_DOWNLOADS=16
DL_MAX_ACTIVE_DOWNLOADS_PER_CLIENT=2
DL_INSPECT_PER_MINUTE=20
DL_DOWNLOADS_PER_MINUTE=6

# Reverse proxy addresses allowed to set X-Forwarded-For (comma-separated).
DL_FORWARDED_ALLOW_IPS=127.0.0.1

# Send HSTS (only when served exclusively over HTTPS).
DL_HSTS=false

# Prometheus /metrics. Set a token to require "Authorization: Bearer <token>".
DL_METRICS_ENABLED=true
DL_METRICS_TOKEN=

# Max simultaneous connections (SSE streams included).
DL_LIMIT_CONCURRENCY=2048

DL_LOG_LEVEL=INFO
# Log the tail of worker stderr on internal/extractor failures (may contain URLs).
DL_LOG_WORKER_STDERR=false
